# BrewLite Environment Variables Example

# Database (PostgreSQL)
POSTGRES_USER=brewlite
POSTGRES_PASSWORD=brewlite
POSTGRES_DB=brewlite
DATABASE_URL="postgresql://brewlite:brewlite@localhost:5433/brewlite"

# Backend
PORT=4000
JWT_SECRET="brewlite-super-secret-jwt-key-2026"
JWT_EXPIRES_IN="1d"

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
